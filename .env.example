# ---------------------------------------------------------------------------
# Bhū-Pramāṇa — environment configuration
#
# EVERYTHING HERE IS OPTIONAL. With nothing set, the platform runs fully
# offline: bundled data, hybrid retrieval, deterministic synthesis, simulation,
# decision rule and maps. Copy to .env.local to use.
# ---------------------------------------------------------------------------

# --- LLM (optional): rephrases the casefile's evidence synthesis --------------
# Every citation in the LLM's answer is validated against the retrieved
# records; if validation fails the deterministic synthesis is used instead.
# Provider: none | anthropic   (auto-selects "anthropic" when a key is present)
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# Default model: claude-opus-5-5
LLM_MODEL=
